    {
      "id": "W8B48yv-z7CkdcnpnTliS",
      "type": "text",
      "x": 6666.602314002511,
      "y": 2696.587578035837,
      "width": 443.2290256166225,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEH",
      "roundness": null,
      "seed": 114969843,
      "version": 263,
      "versionNonce": 1872202461,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1794239393759,
      "created": 1794239385133,
      "link": null,
      "locked": false,
      "text": "倾城故事是一段关于相遇、命运与情感的沉浸式旅程。你将置\n身于一个鲜活而真实的世界，与性格各异的人物相遇。每个人\n都有自己的秘密、欲望与人生轨迹。",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "倾城故事是一段关于相遇、命运与情感的沉浸式旅程。你将置身于一个鲜活而真实的世界，与性格各异的人物相遇。每个人都有自己的秘密、欲望与人生轨迹。",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
