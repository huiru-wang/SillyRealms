{
  "name": "sillyrealms",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "node scripts/start.mjs dev",
    "debug": "node scripts/start.mjs debug",
    "build": "pnpm --filter @sillyrealms/web build",
    "start": "node scripts/start.mjs start",
    "stop": "node scripts/stop.mjs",
    "dev:server": "pnpm --filter @sillyrealms/server dev",
    "dev:web": "pnpm --filter @sillyrealms/web dev",
    "dev:stage": "pnpm --filter @sillyrealms/web dev:world-preview",
    "test": "pnpm test:scripts && pnpm --filter @sillyrealms/server test && pnpm --filter @sillyrealms/web test && pnpm test:world-cards",
    "test:scripts": "node --test scripts/start.test.mjs scripts/stop.test.mjs",
    "test:web": "pnpm --filter @sillyrealms/web test",
    "test:browser": "pnpm --filter @sillyrealms/web test:theme && pnpm --filter @sillyrealms/web test:visual",
    "typecheck": "pnpm --filter @sillyrealms/server typecheck && pnpm --filter @sillyrealms/web typecheck",
    "lint": "pnpm --filter @sillyrealms/server lint",
    "world:check": "pnpm --filter @sillyrealms/server exec tsx ../../scripts/world-card.mts check",
    "world:pack": "pnpm --filter @sillyrealms/server exec tsx ../../scripts/world-card.mts pack",
    "test:world-cards": "pnpm --filter @sillyrealms/server exec tsx --test ../../scripts/world-card.test.mts"
  }
}
