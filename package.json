{
  "name": "sillyrealms",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm --filter @sillyrealms/server dev",
    "test": "pnpm --filter @sillyrealms/server test",
    "typecheck": "pnpm --filter @sillyrealms/server typecheck && pnpm --filter @sillyrealms/web typecheck",
    "lint": "pnpm --filter @sillyrealms/server lint",
    "dev:web": "pnpm --filter @sillyrealms/web dev",
    "build": "pnpm --filter @sillyrealms/web build",
    "test:browser": "node apps/web/test/composer/run.mjs && SR_BROWSER_ONLY=worldstory-font node apps/web/test/composer/run.mjs",
    "dev:studio": "pnpm --filter @sillyrealms/studio dev",
    "dev:studio:mock": "pnpm --filter @sillyrealms/studio dev:mock",
    "build:studio": "pnpm --filter @sillyrealms/studio build",
    "test:studio:visual": "pnpm --filter @sillyrealms/studio test:visual"
  }
}
