{
  "name": "sillyrealms",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "pnpm --filter @sillyrealms/server-v2 test && pnpm --filter @sillyrealms/studio-v2 test",
    "typecheck": "pnpm --filter @sillyrealms/server-v2 typecheck && pnpm --filter @sillyrealms/studio-v2 typecheck",
    "lint": "pnpm --filter @sillyrealms/server-v2 lint",
    "build": "pnpm --filter @sillyrealms/studio-v2 build",
    "test:browser": "pnpm --filter @sillyrealms/studio-v2 test:theme && pnpm --filter @sillyrealms/studio-v2 test:visual",
    "dev:studio": "node scripts/dev.mjs --studio",
    "build:studio": "pnpm --filter @sillyrealms/studio-v2 build",
    "test:studio:visual": "pnpm --filter @sillyrealms/studio-v2 test:visual",
    "start": "node scripts/dev.mjs --built",
    "dev:all": "node scripts/dev.mjs",
    "dev:studio-v2": "pnpm --filter @sillyrealms/studio-v2 dev",
    "dev:server-v2": "pnpm --filter @sillyrealms/server-v2 dev",
    "build:studio-v2": "pnpm --filter @sillyrealms/studio-v2 build",
    "test:studio-v2": "pnpm --filter @sillyrealms/studio-v2 test",
    "dev:world-preview-v2": "pnpm --filter @sillyrealms/studio-v2 dev:world-preview"
  }
}
