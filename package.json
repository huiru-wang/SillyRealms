{
  "name": "sillyrealms",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm --filter @sillyrealms/server dev",
    "test": "pnpm --filter @sillyrealms/server test && pnpm --filter @sillyrealms/server-v2 test",
    "typecheck": "pnpm --filter @sillyrealms/server typecheck && pnpm --filter @sillyrealms/server-v2 typecheck && pnpm --filter @sillyrealms/studio typecheck",
    "lint": "pnpm --filter @sillyrealms/server lint && pnpm --filter @sillyrealms/server-v2 lint",
    "build": "pnpm --filter @sillyrealms/studio build",
    "test:browser": "pnpm --filter @sillyrealms/studio test:theme && pnpm --filter @sillyrealms/studio test:visual",
    "dev:studio": "pnpm --filter @sillyrealms/studio dev",
    "build:studio": "pnpm --filter @sillyrealms/studio build",
    "test:studio:visual": "pnpm --filter @sillyrealms/studio test:visual",
    "start": "pnpm --filter @sillyrealms/server start",
    "dev:all": "node scripts/dev.mjs"
  }
}
